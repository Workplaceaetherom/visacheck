# VisaCheck — Cloudflare Pages _headers
# These headers are applied when this site is deployed on Cloudflare Pages.
# In the Next.js dev environment (sandbox), the equivalent headers are set via
# src/proxy.ts (CSP + per-request nonce) and next.config.ts (static asset cache rules).
#
# DO NOT remove existing entries — append-only per Phase 1.5 spec §3.6.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; manifest-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Service worker — critical scope header. Without this, Cloudflare Pages may
# default the SW scope to its own directory instead of '/'.
/sw.js
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Manifest — must be served with the correct content type.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# Icons — immutable, 1-year cache.
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable

/icon-maskable-512.png
  Cache-Control: public, max-age=31536000, immutable

# Apple touch icon (bonus for iOS)
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

# Screenshots — immutable, 1-year cache.
/screenshot-mobile-1.png
  Cache-Control: public, max-age=31536000, immutable

/screenshot-desktop-1.png
  Cache-Control: public, max-age=31536000, immutable

# Static app shell — phase 0 assets (when ported to Cloudflare).
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/app.css
  Cache-Control: public, max-age=86400
/app.js
  Cache-Control: public, max-age=86400
