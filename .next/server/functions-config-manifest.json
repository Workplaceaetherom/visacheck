{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon|icon-|screenshot-|manifest|sw.js|apple-touch-icon).*))(\\.json)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon|icon-|screenshot-|manifest|sw.js|apple-touch-icon).*)"
        }
      ]
    },
    "/api/announcements": {},
    "/api/check": {},
    "/api/compare": {},
    "/api/countries": {},
    "/api/live": {}
  }
}